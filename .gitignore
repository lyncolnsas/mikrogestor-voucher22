# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# tools
/tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caddy reverse proxy binary (baixar via Instalar_Caddy.bat)
/caddy/

# local database & auth
*.db
*.db-journal
*.db-wal
*.db-shm
/baileys_auth_info/
/baileys_session/
/baileys_sessions/
/scratch/


# WhatsApp runtime state
whatsapp_states.json
*.wwebjs_auth


